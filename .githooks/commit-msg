#!/bin/sh
# Strip AI attribution from commit messages: Co-Authored-By: Claude/Anthropic,
# Claude-Session trailers, and "Generated with/by Claude Code" lines.
# CI's "Check for AI attribution" step (changelog.yml) matches the same lines.
grep -viE '^co-authored-by:.*(claude|anthropic)|^claude-session:|generated (with|by) .*claude' "$1" | git stripspace > "$1.tmp" && mv "$1.tmp" "$1"
