# Force LF line endings across the repo so oxfmt/oxlint behave the same on
# Windows, macOS, and Linux regardless of core.autocrlf settings.
* text=auto eol=lf

# Lockfiles should never be touched by humans; keep LF and mark as generated.
bun.lock binary
*.lock binary

# Generated Prisma client output is regenerated by `prisma generate`.
apps/api/src/generated/** linguist-generated=true

# Built catalog: minified one-line JSON, collapsed in PR diffs. Review it via
# the `bun run data:diff` summary in the data PR body. _report.json stays
# expanded since its new entries flag curation work.
apps/web/public/data/** linguist-generated=true
apps/web/public/data/_report.json -linguist-generated

# Static binary content
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
