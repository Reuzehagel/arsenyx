# Local dev only — wrangler.toml overrides this to "production" on deploy.
# Drives the dev-only email+password sign-in path.
NODE_ENV="development"

# Don't fill these by hand: `just setup` points both at this checkout's database
# in the local Docker Postgres (compose.yaml). Never put the prod (*.psdb.cloud)
# string here — setup and the seed scripts refuse it.
#
# Used by the Prisma CLI (db:push / db:studio / db:generate) and the seed scripts.
DATABASE_URL="postgresql://USER:PASS@HOST:5432/postgres"

# What the local Worker's Hyperdrive binding connects to under `wrangler dev`.
CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE="postgresql://USER:PASS@HOST:5432/postgres"

# Better Auth
BETTER_AUTH_SECRET="generate with: openssl rand -base64 32"
BETTER_AUTH_URL="http://localhost:8787"

# GitHub OAuth (https://github.com/settings/developers)
# Callback: http://localhost:8787/auth/callback/github
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Web origin (for CORS). Comma-separated.
WEB_ORIGIN="http://localhost:5173"
