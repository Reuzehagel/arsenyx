al implosion. Implosion damage increases based on damage dealt between anchor drop and rewind. Everything lost or expended in that time is returned.\r\nDying while Anchor is active rewinds Protea to the anchor, saving her. Protea is knocked down and the anchor vanishes.","imageName":"https://img.arsenyx.com/ProteaTemporalAnchor-78bd2301.png","stats":[{"label":"Energy Cost: |val1|","scale":"efficiency","values":[100]},{"label":"Recorded Damage Conversion: |val1|%","scale":"strength","values":[25]},{"label":"Implosion Range: |val1|m","scale":"range","values":[15]},{"label":"Anchor Duration: |val1|s","scale":"duration","values":[8]},{"label":"Initial Invulnerability Phase: |val1|s","values":[3]},{"label":"Enemy Knockdown Chance On Implosion: |val1|%","values":[100]},{"label":"Status Cleanse On Rewind: |val1|%","values":[100]},{"label":"Rewind Countdown: |val1|s","values":[1.5]},{"label":"Self Knockdown Chance On Lethal Hit: |val1|%","values":[100]},{"label":"Health Restore On Lethal Hit: |val1|%","values":[5]}]}],"polarities":["madurai","naramon"],"auraPolarity":"any","exilusPolarity":null,"isPrime":false,"imageName":"https://img.arsenyx.com/Odalisk-f74cc5da.png","displayClass":"Warframe"}