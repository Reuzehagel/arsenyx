{"uniqueName":"/Lotus/Powersuits/Odalisk/Odalisk","name":"Protea","category":"warframes","description":"Protea knows all about protection. Her vast arsenal inflicts damage and provides ally support. She can even manipulate time itself.","health":270,"shield":455,"armor":135,"stamina":3,"power":175,"sprintSpeed":1.2,"masteryReq":0,"passiveDescription":"Every |CASTS|th Power Cast is granted +|STRENGTH|% Ability Strength.","exalted":[],"modPools":["WARFRAME","AURA","Protea"],"abilities":[{"uniqueName":"/Lotus/Powersuits/Odalisk/Abilities/OdaliskFanAbility","name":"Grenade Fan","description":"Throw out grenades in an arc.\r\n\r\n(TAP) SHRAPNEL VORTEX\r\nCreates a slashing, staggering swirl of shrapnel.\r\n\r\n(HOLD) SHIELD SATELLITES\r\nProtea reconfigures Grenades to work as overcharging shield generators, protecting her, her allies and companions. When Shields break, a Satellite is destroyed to double minimum Shield Gate invincibility time.","imageName":"https://img.arsenyx.com/ProteaGrenadeFan-27b5f8d8.png","stats":[{"label":"Energy Cost: |val1|","scale":"efficiency","values":[25]},{"label":"Slash Damage Per Second: |val1|","scale":"strength","values":[500]},{"label":"Shield Restore On Attach: |val1|","scale":"strength","values":[500]},{"label":"Shield Points Per Second: |val1|","scale":"strength","values":[50]},{"label":"Vortex And Pickup Radii: |val1|m","scale":"range","values":[5]},{"label":"Duration: |val1|s","scale":"duration","values":[13]},{"label":"Initial Jump Height: |val1|m","values":[1]},{"label":"Shrapnel Grenades Per Throw: |val1|","values":[3]},{"label":"Shrapnel Grenade Spread: |val1|°","values":[135]},{"label":"Slash Status Chance: |val1|%","values":[33]},{"label":"Stagger Chance: |val1|%","values":[100]},{"label":"Shield Grenades Per Throw: |val1|","values":[4]},{"label":"Shield Grenade Spread: |val1|°","values":[135]},{"label":"Limit Of Allies Per Satellite: |val1|","values":[1]},{"label":"Shield Gate Extension: |val1|s","values":[2]}]},{"uniqueNam